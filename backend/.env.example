APP_NAME="HSE Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hse_dashboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=sync

# --- Frontend React (SPA auth via Sanctum) ---
# Isi persis alamat React dev server kamu (tanpa trailing slash), boleh lebih dari satu (pisah koma).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# --- Email ---
# development: biarkan "log" supaya email cuma ditulis ke storage/logs/laravel.log (tidak perlu SMTP asli)
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hse-dashboard.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- WhatsApp Notification (opsional, lihat README > Setup Notifikasi WhatsApp) ---
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=fonnte
FONNTE_TOKEN=
FONNTE_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_FALLBACK_NUMBER=
